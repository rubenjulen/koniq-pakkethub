# ---- PakketHub staging/productie env ---------------------------------------

# Site-brede staging-poort. Zet dit om de hele omgeving achter één wachtwoord te
# zetten (alleen genodigde compagnons). Leeg laten = geen poort (bv. lokaal).
STAGING_PASSWORD=kies-een-sterk-wachtwoord

# Database. Standaard draait een ingebedde demo-database (PGlite) in PGLITE_DIR.
# Mount daar een persistent volume zodat testdata blijft staan.
PGLITE_DIR=/data/pgdata

# Optioneel: gebruik een echte Postgres i.p.v. PGlite (aanrader voor duurzaamheid).
# Zet dan DATABASE_URL; het schema is Postgres-compatibel en seedt automatisch.
# DATABASE_URL=postgres://user:pass@host:5432/pakkethub

# Bij gebruik van docker-compose.yml: het wachtwoord voor de meegeleverde Postgres.
DB_PASSWORD=verander-dit

# Demo-data seeden bij eerste boot (maakt de demo-accounts aan). Laat op true voor
# staging; zet op false zodra je geen demo-data meer wilt.
SEED_ON_BOOT=true

# Externe providers draaien standaard in SIMULATED-modus (ideaal voor testen).
# Pas bij echte livegang aanzetten met echte integraties:
# PAYMENTS_MODE=LIVE
# KYC_MODE=LIVE
# NOTIFY_MODE=LIVE
